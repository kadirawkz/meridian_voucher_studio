# syntax=docker/dockerfile:1.7

# Build Stage
FROM node:24-alpine AS builder

WORKDIR /usr/src/app

COPY package*.json ./
# Reduce npm concurrency and add stronger retry behavior for flaky registry connections.
RUN --mount=type=cache,target=/root/.npm \
    npm config set maxsockets 1 \
 && npm config set fetch-retries 10 \
 && npm config set fetch-retry-factor 3 \
 && npm config set fetch-retry-mintimeout 30000 \
 && npm config set fetch-retry-maxtimeout 240000 \
 && npm ci --no-audit --no-fund --prefer-offline --network-concurrency=1

COPY . .

# Compose passes these through at build time so the browser bundle gets the
# same public runtime config the Electron app expects.
ARG SUPABASE_URL=""
ARG SUPABASE_ANON_KEY=""
ARG VOUCHER_API_PORT=5000
ENV SUPABASE_URL=${SUPABASE_URL}
ENV SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
ENV VOUCHER_API_PORT=${VOUCHER_API_PORT}

# Build static React SPA
RUN npm run sync:public-config
RUN npx vite build

# Nginx Stage to serve built assets
FROM nginx:alpine

COPY --from=builder /usr/src/app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
