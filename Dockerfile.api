# syntax=docker/dockerfile:1.7

# Build Stage
FROM node:24-alpine AS builder

WORKDIR /usr/src/app

COPY package*.json ./
COPY tsconfig*.json ./

# Reduce npm concurrency and add stronger retry behavior for flaky registry connections.
RUN --mount=type=cache,target=/root/.npm \
    npm config set maxsockets 1 \
 && npm config set fetch-retries 10 \
 && npm config set fetch-retry-factor 3 \
 && npm config set fetch-retry-mintimeout 30000 \
 && npm config set fetch-retry-maxtimeout 240000 \
 && npm ci --no-audit --no-fund --prefer-offline --network-concurrency=1

COPY electron ./electron

# Build Express API and related backend structures
RUN npx tsc -p tsconfig.electron.json

# Prune dev dependencies for production
RUN npm prune --omit=dev

# Production Stage
FROM node:24-alpine AS runner

# Install Chromium and required fonts/libraries for PDF generation
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont

WORKDIR /usr/src/app

COPY package*.json ./
COPY --from=builder /usr/src/app/node_modules ./node_modules
COPY --from=builder /usr/src/app/dist-electron ./dist-electron
COPY templates ./templates

ENV NODE_ENV=production
ENV VOUCHER_API_PORT=5000
ENV VOUCHER_API_HOST=0.0.0.0
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

EXPOSE 5000

CMD ["node", "dist-electron/main/standalone.js"]
