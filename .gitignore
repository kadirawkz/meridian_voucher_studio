# ------------------------------------------------------------------------------
# Local Test & Generated Documents
# ------------------------------------------------------------------------------
# Ignore local test and output documents at the root
test-out.docx
test-out.pdf
*.docx
*.pdf

# Explicitly ensure the controlled master templates directory remains tracked
!templates/
!templates/**/*.docx
!templates/**/*.pdf

# ------------------------------------------------------------------------------
# Local Session Data & Persistent Storage
# ------------------------------------------------------------------------------
data/
documents/


